{
  "theme": "maple",
  "name": "AlexWeb",
  "colors": {
    "primary": "#0087D1",
    "light": "#02A0E4",
    "dark": "#014C9B"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "navigation": {
    "versions": [
      {
        "version": "V1",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "v1/release"
            ]
          },
          {
            "group": "API Usage",
            "pages": [
              "v1/base",
              "echo-endpoint",
              "v1/api-keys",
              "v1/oauth",
              "v1/applications",
              "v1/resources",
              "v1/events",
              "v1/webhooks",
              "v1/schedules",
              "v1/usage",
              "v1/home-assistant"
            ]
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Inter"
  },
  "redirects": [
    {
      "source": "/welcome-to-the-alex-web-api-documentation",
      "destination": "/v1/release",
      "permanent": true
    }
  ],
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/images/Icon.png",
  "logo": {
    "light": "/images/Favicon.svg",
    "dark": "/images/Favicon-Dark.svg"
  }
}
